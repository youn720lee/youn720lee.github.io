{%- set L = profile.links -%}
{%- set link_order = [("paper","Paper"),("pdf","PDF"),("arxiv","arXiv"),("doi","DOI"),("code","Code"),("project","Project"),("dataset","Dataset"),("video","Video"),("slides","Slides"),("poster","Poster")] -%}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ profile.site_title }}</title>
  <meta name="description" content="{{ profile.name }} — {{ profile.role }}, {{ profile.org }}. {{ profile.tagline }}">
  <meta name="author" content="{{ profile.name }}">
  <meta property="og:type" content="profile">
  <meta property="og:title" content="{{ profile.name }}">
  <meta property="og:description" content="{{ profile.tagline }}">
  <meta property="og:url" content="{{ profile.site_url }}/">
  <meta property="og:image" content="{{ profile.site_url }}/{{ profile.avatar }}">
  <link rel="canonical" href="{{ profile.site_url }}/">
  <link rel="icon" href="assets/img/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="assets/css/style.css?v={{ asset_v.css }}">
  <script>
    // Apply the saved theme before first paint to avoid a flash.
    (function () { try { var t = localStorage.getItem('theme'); if (t === 'dark' || (!t && window.matchMedia('(prefers-color-scheme: dark)').matches)) { document.documentElement.setAttribute('data-theme', 'dark'); } } catch (e) {} })();
  </script>
  <script type="application/ld+json">
  {"@context":"https://schema.org","@type":"Person","name":"{{ profile.name }}","alternateName":"{{ profile.name_native }}","jobTitle":"{{ profile.role }}","worksFor":{"@type":"Organization","name":"{{ profile.org }}"},"url":"{{ profile.site_url }}/","email":"mailto:{{ profile.email }}","sameAs":[{% for k, v in L.items() %}"{{ v }}"{% if not loop.last %},{% endif %}{% endfor %}]}
  </script>
</head>
<body>
<svg xmlns="http://www.w3.org/2000/svg" style="display:none" aria-hidden="true">
  <symbol id="i-mail" viewBox="0 0 24 24"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></symbol>
  <symbol id="i-scholar" viewBox="0 0 24 24"><path class="fill" d="M5.242 13.769 0 9.5 12 0l12 9.5-5.242 4.269C17.548 11.249 14.978 9.5 12 9.5c-2.977 0-5.548 1.748-6.758 4.269zM12 10a7 7 0 1 0 0 14 7 7 0 0 0 0-14z"/></symbol>
  <symbol id="i-github" viewBox="0 0 24 24"><path class="fill" d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></symbol>
  <symbol id="i-linkedin" viewBox="0 0 24 24"><path class="fill" d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"/></symbol>
  <symbol id="i-orcid" viewBox="0 0 24 24"><path class="fill" d="M12 0C5.372 0 0 5.372 0 12s5.372 12 12 12 12-5.372 12-12S18.628 0 12 0zM7.369 4.378c.525 0 .947.431.947.947s-.422.947-.947.947a.95.95 0 0 1-.947-.947c0-.525.422-.947.947-.947zm-.722 3.038h1.444v10.041H6.647V7.416zm3.562 0h3.9c3.712 0 5.344 2.653 5.344 5.025 0 2.578-2.016 5.025-5.325 5.025h-3.919V7.416zm1.444 1.303v7.444h2.297c3.272 0 4.022-2.484 4.022-3.722 0-2.016-1.284-3.722-4.097-3.722h-2.222z"/></symbol>
  <symbol id="i-trophy" viewBox="0 0 24 24"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></symbol>
  <symbol id="i-cv" viewBox="0 0 24 24"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/></symbol>
  <symbol id="i-sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></symbol>
  <symbol id="i-moon" viewBox="0 0 24 24"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></symbol>
  <symbol id="i-grad" viewBox="0 0 24 24"><path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"/><path d="M22 10v6"/><path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"/></symbol>
  <symbol id="i-pin" viewBox="0 0 24 24"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></symbol>
  <symbol id="i-award" viewBox="0 0 24 24"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/></symbol>
  <symbol id="i-quote" viewBox="0 0 24 24"><path d="M16 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z"/><path d="M5 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z"/></symbol>
  <symbol id="i-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></symbol>
  <symbol id="i-copy" viewBox="0 0 24 24"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></symbol>
  <symbol id="i-x" viewBox="0 0 24 24"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></symbol>
  <symbol id="i-menu" viewBox="0 0 24 24"><path d="M4 6h16"/><path d="M4 12h16"/><path d="M4 18h16"/></symbol>
  <symbol id="i-ext" viewBox="0 0 24 24"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></symbol>
  <symbol id="i-up" viewBox="0 0 24 24"><path d="m18 15-6-6-6 6"/></symbol>
  <symbol id="i-bib" viewBox="0 0 24 24"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/></symbol>
</svg>

<header class="nav" id="top">
  <div class="container nav-inner">
    <a class="brand" href="#top">{{ profile.name }}</a>
    <button class="nav-toggle" id="nav-toggle" aria-label="Toggle menu" aria-expanded="false"><svg class="icon"><use href="#i-menu"/></svg></button>
    <nav class="nav-links" id="nav-links">
      <a href="#about">About</a>
      <a href="#experience">Experience</a>
      <a href="#publications">Publications</a>
      <a href="#projects">Projects</a>
      <a href="#awards">Awards</a>
      <a href="#activities">Talks &amp; Service</a>
      <a href="#patents">Patents</a>
      <button class="theme-toggle" id="theme-toggle" aria-label="Toggle dark mode" title="Toggle dark mode">
        <svg class="icon sun"><use href="#i-sun"/></svg><svg class="icon moon"><use href="#i-moon"/></svg>
      </button>
    </nav>
  </div>
</header>

<main>
  <!-- ======================= ABOUT ======================= -->
  <section id="about" class="section about">
    <div class="container about-grid">
      <aside class="profile-card">
        <img class="avatar" src="{{ profile.avatar }}" alt="{{ profile.name }}" width="220" height="220">
        <h1 class="name">{{ profile.name }}</h1>
        <p class="role">{{ profile.role }} <span class="at">@</span> <a href="{{ profile.org_url }}" target="_blank" rel="noopener">{{ profile.org }}</a></p>
        <p class="group">{{ profile.group }}</p>
        <ul class="social">
          {% if L.scholar %}<li><a class="social-scholar" href="{{ L.scholar }}" target="_blank" rel="noopener" title="Google Scholar" aria-label="Google Scholar"><svg class="icon"><use href="#i-scholar"/></svg><span class="sr-only">Google Scholar</span></a></li>{% endif %}
          {% if L.github %}<li><a class="social-github" href="{{ L.github }}" target="_blank" rel="noopener" title="GitHub" aria-label="GitHub"><svg class="icon"><use href="#i-github"/></svg><span class="sr-only">GitHub</span></a></li>{% endif %}
          {% if L.linkedin %}<li><a class="social-linkedin" href="{{ L.linkedin }}" target="_blank" rel="noopener" title="LinkedIn" aria-label="LinkedIn"><svg class="icon"><use href="#i-linkedin"/></svg><span class="sr-only">LinkedIn</span></a></li>{% endif %}
          {% if profile.cv %}<li><a class="social-cv" href="{{ profile.cv }}" target="_blank" rel="noopener" title="CV"><svg class="icon"><use href="#i-cv"/></svg><span class="sr-only">CV</span></a></li>{% endif %}
        </ul>
        {% if profile.stats %}
        <ul class="stats" title="{{ profile.stats_note }}">
          {% for st in profile.stats %}<li><span class="stat-value">{{ st.value }}</span><span class="stat-label">{{ st.label }}</span></li>{% endfor %}
        </ul>
        {% endif %}
      </aside>

      <div class="about-body">
        <h2 class="h2">Introduction</h2>
        {% if profile.tagline %}<p class="lead">{{ profile.tagline }}</p>{% endif %}
        {% for para in profile.bio %}
        <p class="bio">{{ para | safe }}</p>
        {% endfor %}
        <div class="about-cols">
          <div>
            <h3 class="h3">Interests</h3>
            <ul class="interests">
              {% for it in profile.interests %}<li>{{ it }}</li>{% endfor %}
            </ul>
          </div>
          <div>
            <h3 class="h3">Education</h3>
            <ul class="edu">
              {% for e in profile.education %}
              <li>
                <svg class="icon"><use href="#i-grad"/></svg>
                <div>
                  <div class="edu-degree">{{ e.degree }}</div>
                  <div class="edu-inst">{{ e.institution }}{% if e.period %} · {{ e.period }}{% elif e.year %} · {{ e.year }}{% endif %}</div>
                  {% if e.note %}<div class="edu-note">{{ e.note }}</div>{% endif %}
                </div>
              </li>
              {% endfor %}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ======================= NEWS + WORK EXPERIENCE ======================= -->
  <section id="news" class="section section-compact section-alt">
    <div class="container two-col">
      <div class="col col-news">
        <h2 class="h2">News</h2>
        <ul class="news" id="news-list">
          {% for n in profile.news %}
          <li{% if loop.index > 3 %} class="news-more" hidden{% endif %}><span class="news-date">{{ n.date }}</span><span class="news-text">{{ n.text | safe }}</span></li>
          {% endfor %}
        </ul>
        {% if profile.news | length > 3 %}
        <button type="button" class="news-toggle" id="news-toggle" aria-expanded="false" aria-controls="news-list">Show {{ profile.news | length - 3 }} more</button>
        {% endif %}

      </div>
      <div class="col col-exp" id="experience" data-nav>
        <h2 class="h2">Work Experience</h2>
        <ol class="timeline">
          {% for x in profile.experience %}
          <li class="tl-item{% if loop.index > 2 %} tl-more{% endif %}"{% if loop.index > 2 %} hidden{% endif %}>
            <div class="tl-dot"></div>
            <div class="tl-body">
              <div class="tl-head">
                <h3 class="tl-title">{{ x.title }}</h3>
                <span class="tl-dates">{{ x.start }} – {{ x.end }}</span>
              </div>
              <div class="tl-org">{{ x.org }}{% if x.location %} <span class="tl-loc"><svg class="icon"><use href="#i-pin"/></svg>{{ x.location }}</span>{% endif %}</div>
              {% if x.bullets %}
              <details class="tl-details">
                <summary>Details</summary>
                <ul class="tl-bullets">{% for b in x.bullets %}<li>{{ b }}</li>{% endfor %}</ul>
              </details>
              {% endif %}
            </div>
          </li>
          {% endfor %}
        </ol>
        {% if profile.experience | length > 2 %}
        <button type="button" class="news-toggle" id="exp-toggle" aria-expanded="false">Show {{ profile.experience | length - 2 }} earlier</button>
        {% endif %}

      </div>
    </div>
  </section>

  <!-- ======================= PUBLICATIONS ======================= -->
  <section id="publications" class="section">
    <div class="container">
      <div class="pub-header">
        <h2 class="h2">Publications</h2>
        <div class="pub-tools">
          <label class="search"><svg class="icon"><use href="#i-search"/></svg><input id="pub-search" type="search" placeholder="Search title, author, venue…" aria-label="Search publications" autocomplete="off"><kbd class="kbd" aria-hidden="true">/</kbd><button type="button" class="search-clear" id="pub-clear" aria-label="Clear search" hidden><svg class="icon"><use href="#i-x"/></svg></button></label>
          <a class="btn btn-ghost" href="assets/publications.bib" download title="Download all entries as BibTeX"><svg class="icon"><use href="#i-bib"/></svg>BibTeX</a>
        </div>
      </div>
      <div class="filters" role="tablist" aria-label="Filter publications">
        <button class="filter is-active" data-filter="all" title="Show every international publication">All <span class="count">{{ counts.all }}</span></button>
        <button class="filter" data-filter="conference">Conference <span class="count">{{ counts.conference }}</span></button>
        <button class="filter" data-filter="workshop">Workshop <span class="count">{{ counts.workshop }}</span></button>
        <button class="filter" data-filter="journal">Journal <span class="count">{{ counts.journal }}</span></button>
        <button class="filter" data-filter="preprint">Preprint <span class="count">{{ counts.preprint }}</span></button>
      </div>
      <p class="pub-count" id="pub-count" aria-live="polite">Showing all {{ counts.all }} publications</p>

      <div id="pub-list">
      {% for yg in years %}
        <div class="year-group" data-year="{{ yg.year }}">
          <h3 class="year">{{ yg.year }}</h3>
          {% for p in yg.pubs %}
          {% set primary = p.links.paper or p.links.pdf or p.links.doi or p.links.arxiv or p.links.project or '' %}
          <article class="pub" data-type="{{ p.type }}" data-search="{{ p.search }}">
            {% if primary %}<a class="pub-thumb" href="{{ primary }}" target="_blank" rel="noopener" tabindex="-1">{% else %}<div class="pub-thumb">{% endif %}
              <img src="{{ p.image }}" alt="" loading="lazy" width="240" height="160">
            {% if primary %}</a>{% else %}</div>{% endif %}
            <div class="pub-body">
              <h4 class="pub-title">{% if primary %}<a href="{{ primary }}" target="_blank" rel="noopener">{{ p.title }}</a>{% else %}{{ p.title }}{% endif %}</h4>
              <p class="pub-authors">
                {% for a in p.authors %}{% if a == self_name %}<strong>{{ a }}</strong>{% else %}{{ a }}{% endif %}{% if not loop.last %}, {% endif %}{% endfor %}
              </p>
              <p class="pub-venue">
                <span class="venue">{{ p.venue_html | safe }}</span>{% if p.note %} <span class="pub-extra">{{ p.note_html | safe }}</span>{% endif %}{% if p.volume %}, vol. {{ p.volume }}{% endif %}{% if p.number %}, no. {{ p.number }}{% endif %}{% if p.pages %}, pp. {{ p.pages }}{% endif %}{% if not p.note %}, {{ p.year }}{% endif %}.
              </p>
              <div class="pub-foot">
                <div class="pub-meta">
                  <span class="type type-{{ p.type }}">{{ p.type_label }}</span>
                  {% for t in p.tags %}<span class="badge">{{ t }}</span>{% endfor %}
                  {% if p.award %}<span class="badge badge-award"><svg class="icon"><use href="#i-trophy"/></svg>{{ p.award }}</span>{% endif %}
                </div>
                <div class="pub-links">
                  {% for k, label in link_order %}{% if p.links[k] %}<a class="btn" href="{{ p.links[k] }}" target="_blank" rel="noopener">{{ label }}</a>{% endif %}{% endfor %}
                  <button class="btn btn-cite" data-bib="bib-{{ p.key }}" data-title="{{ p.title }}"><svg class="icon"><use href="#i-quote"/></svg>Cite</button>
                </div>
              </div>
              <pre class="bib" id="bib-{{ p.key }}" hidden>{{ p.bibtex }}</pre>
            </div>
          </article>
          {% endfor %}
        </div>
      {% endfor %}
      </div>
      <div class="empty" id="pub-empty" hidden>
        <p>No publications match <strong id="pub-empty-q"></strong>. Try a shorter keyword, an author name, or a venue such as <em>ICRA</em>.</p>
        <button type="button" class="btn btn-primary" id="pub-reset">Show all publications</button>
      </div>

      {% if domestic %}
      <details class="domestic">
        <summary><span>Domestic conference papers (Korea)</span><span class="count">{{ domestic | length }}</span></summary>
        <ol class="domestic-list">
          {% for p in domestic %}
          <li>
            <span class="d-title">{{ p.title }}</span>
            <span class="d-authors">{% for a in p.authors %}{% if a == self_name %}<strong>{{ a }}</strong>{% else %}{{ a }}{% endif %}{% if not loop.last %}, {% endif %}{% endfor %}</span>
            <span class="d-venue">{{ p.venue }}{% if p.pages %}, pp. {{ p.pages }}{% endif %}, {{ p.year }}.{% if p.award %} <span class="badge badge-award"><svg class="icon"><use href="#i-trophy"/></svg>{{ p.award }}</span>{% endif %}</span>
          </li>
          {% endfor %}
        </ol>
      </details>
      {% endif %}
    </div>
  </section>

  {% if projects %}
  <!-- ======================= PROJECTS ======================= -->
  <section id="projects" class="section section-alt">
    <div class="container">
      <h2 class="h2">Industry Projects</h2>
      <p class="section-lead">R&amp;D programmes I have worked on at Samsung Electronics, from vision inspection foundation models to the MLOps and robotics that put them on production lines.</p>
      <div class="projects">
        {% for pj in projects %}
        <article class="project">
          <div class="project-head">
            <h3 class="project-title">{{ pj.title }}</h3>
            <span class="chip chip-period">{{ pj.period }}</span>
          </div>
          {% if pj.role %}<div class="project-role">{{ pj.role }}</div>{% endif %}
          <p class="project-summary">{{ pj.summary }}</p>
          {% if pj.bullets %}<ul class="project-bullets">{% for b in pj.bullets %}<li>{{ b }}</li>{% endfor %}</ul>{% endif %}
          {% if pj.tags %}<div class="tags">{% for t in pj.tags %}<span class="tag">{{ t }}</span>{% endfor %}</div>{% endif %}
        </article>
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  {% if profile.awards %}
  <!-- ======================= AWARDS ======================= -->
  <section id="awards" class="section">
    <div class="container">
      <h2 class="h2">Awards &amp; Honors</h2>
      <ul class="awards">
        {% for a in profile.awards %}
        <li class="award">
          <span class="award-year">{{ a.year }}</span>
          <div class="award-body">
            <div class="award-title"><svg class="icon"><use href="#i-award"/></svg>{{ a.title }}</div>
            <div class="award-by">{{ a.by }}{% if a.note %} — <span class="award-note">{{ a.note }}</span>{% endif %}{% if a.link %} <a class="award-link" href="{{ a.link }}" target="_blank" rel="noopener">Certificate</a>{% endif %}</div>
          </div>
        </li>
        {% endfor %}
      </ul>
    </div>
  </section>
  {% endif %}

  {% set act = profile.activities %}
  {% if act %}
  <!-- ======================= ACTIVITIES ======================= -->
  <section id="activities" class="section section-alt">
    <div class="container">
      <h2 class="h2">Talks &amp; Service</h2>
      <div class="activities">
        {% if act.talks %}
        <div class="act-block">
          <h3 class="h3">Invited Talks</h3>
          <ul class="talks">
            {% for t in act.talks %}<li><div class="talk-title">{{ t.title }}</div><div class="talk-where">{{ t.where }} · {{ t.date }}</div></li>{% endfor %}
          </ul>
        </div>
        {% endif %}
        {% if act.organizing %}
        <div class="act-block">
          <h3 class="h3">Organizing</h3>
          <ul class="plain">{% for o in act.organizing %}<li>{{ o }}</li>{% endfor %}</ul>
        </div>
        {% endif %}
        {% if act.reviewing %}
        <div class="act-block">
          <h3 class="h3">Reviewer</h3>
          <ul class="plain">{% for r in act.reviewing %}<li>{{ r }}</li>{% endfor %}</ul>
        </div>
        {% endif %}
        {% if act.teaching %}
        <div class="act-block">
          <h3 class="h3">Teaching</h3>
          <ul class="plain">{% for r in act.teaching %}<li>{{ r }}</li>{% endfor %}</ul>
        </div>
        {% endif %}
      </div>
    </div>
  </section>
  {% endif %}

  {% if profile.patents %}
  <!-- ======================= PATENTS ======================= -->
  <section id="patents" class="section">
    <div class="container">
      <h2 class="h2">Patents</h2>
      <ol class="patents">
        {% for pt in profile.patents %}
        <li><span class="pt-title">{{ pt.title }}</span><span class="pt-meta">{{ pt.inventors }} · {{ pt.number }}</span></li>
        {% endfor %}
      </ol>
    </div>
  </section>
  {% endif %}
</main>

<footer class="footer">
  <div class="container footer-contact">
    <p class="footer-cta"><span class="contact-label">Contact</span> <a href="mailto:{{ profile.email }}">{{ profile.email }}</a>{% if profile.email_alt %} <span class="sep">·</span> <a href="mailto:{{ profile.email_alt }}">{{ profile.email_alt }}</a>{% endif %}</p>
  </div>
  <div class="container footer-inner">
    <span>© {{ year_now }} {{ profile.name }}. Last updated {{ updated }}.</span>
    <span class="footer-links">
      {% if L.scholar %}<a href="{{ L.scholar }}" target="_blank" rel="noopener">Scholar</a>{% endif %}
      {% if L.github %}<a href="{{ L.github }}" target="_blank" rel="noopener">GitHub</a>{% endif %}
      {% if L.linkedin %}<a href="{{ L.linkedin }}" target="_blank" rel="noopener">LinkedIn</a>{% endif %}
    </span>
  </div>
</footer>

<a href="#top" class="to-top" id="to-top" aria-label="Back to top" title="Back to top"><svg class="icon"><use href="#i-up"/></svg></a>

<dialog id="cite-dialog" class="cite-dialog" aria-labelledby="cite-title">
  <div class="cite-head">
    <h3 id="cite-title">Cite</h3>
    <button class="icon-btn" id="cite-close" aria-label="Close"><svg class="icon"><use href="#i-x"/></svg></button>
  </div>
  <p class="cite-paper" id="cite-paper"></p>
  <pre id="cite-text" class="cite-text"></pre>
  <div class="cite-actions">
    <button class="btn btn-primary" id="cite-copy"><svg class="icon"><use href="#i-copy"/></svg><span>Copy BibTeX</span></button>
  </div>
</dialog>

<script src="assets/js/main.js?v={{ asset_v.js }}"></script>
</body>
</html>
