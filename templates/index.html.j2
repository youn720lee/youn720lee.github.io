{%- set L = profile.links -%}
{%- set link_order = [("paper","Paper"),("pdf","PDF"),("arxiv","arXiv"),("doi","DOI"),("code","Code"),("project","Project"),("dataset","Dataset"),("video","Video"),("slides","Slides"),("poster","Poster")] -%}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ profile.site_title }}</title>
  <meta name="description" content="{{ profile.name }} — {{ profile.role }}, {{ profile.org }}. {{ profile.tagline }}">
  <meta name="author" content="{{ profile.name }}">
  <meta property="og:type" content="profile">
  <meta property="og:title" content="{{ profile.name }}">
  <meta property="og:description" content="{{ profile.tagline }}">
  <meta property="og:url" content="{{ profile.site_url }}/">
  <meta property="og:image" content="{{ profile.site_url }}/{{ profile.avatar }}">
  <link rel="canonical" href="{{ profile.site_url }}/">
  <link rel="icon" href="assets/img/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="assets/css/style.css">
  <script>
    // Apply the saved theme before first paint to avoid a flash.
    (function () { try { var t = localStorage.getItem('theme'); if (t === 'dark' || (!t && window.matchMedia('(prefers-color-scheme: dark)').matches)) { document.documentElement.setAttribute('data-theme', 'dark'); } } catch (e) {} })();
  </script>
  <script type="application/ld+json">
  {"@context":"https://schema.org","@type":"Person","name":"{{ profile.name }}","alternateName":"{{ profile.name_native }}","jobTitle":"{{ profile.role }}","worksFor":{"@type":"Organization","name":"{{ profile.org }}"},"url":"{{ profile.site_url }}/","email":"mailto:{{ profile.email }}","sameAs":[{% for k, v in L.items() %}"{{ v }}"{% if not loop.last %},{% endif %}{% endfor %}]}
  </script>
</head>
<body>
<svg xmlns="http://www.w3.org/2000/svg" style="display:none" aria-hidden="true">
  <symbol id="i-mail" viewBox="0 0 24 24"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></symbol>
  <symbol id="i-scholar" viewBox="0 0 24 24"><path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"/><path d="M22 10v6"/><path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"/></symbol>
  <symbol id="i-github" viewBox="0 0 24 24"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></symbol>
  <symbol id="i-linkedin" viewBox="0 0 24 24"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></symbol>
  <symbol id="i-orcid" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M8 8.5v8"/><circle cx="8" cy="5.8" r=".6"/><path d="M11.5 8.5h3a4 4 0 0 1 0 8h-3z"/></symbol>
  <symbol id="i-cv" viewBox="0 0 24 24"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/></symbol>
  <symbol id="i-sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></symbol>
  <symbol id="i-moon" viewBox="0 0 24 24"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></symbol>
  <symbol id="i-grad" viewBox="0 0 24 24"><path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"/><path d="M22 10v6"/><path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"/></symbol>
  <symbol id="i-pin" viewBox="0 0 24 24"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></symbol>
  <symbol id="i-award" viewBox="0 0 24 24"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/></symbol>
  <symbol id="i-quote" viewBox="0 0 24 24"><path d="M16 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z"/><path d="M5 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z"/></symbol>
  <symbol id="i-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></symbol>
  <symbol id="i-copy" viewBox="0 0 24 24"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></symbol>
  <symbol id="i-x" viewBox="0 0 24 24"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></symbol>
  <symbol id="i-menu" viewBox="0 0 24 24"><path d="M4 6h16"/><path d="M4 12h16"/><path d="M4 18h16"/></symbol>
  <symbol id="i-ext" viewBox="0 0 24 24"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></symbol>
  <symbol id="i-bib" viewBox="0 0 24 24"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/></symbol>
</svg>

<header class="nav" id="top">
  <div class="container nav-inner">
    <a class="brand" href="#top">{{ profile.name }}</a>
    <button class="nav-toggle" id="nav-toggle" aria-label="Toggle menu" aria-expanded="false"><svg class="icon"><use href="#i-menu"/></svg></button>
    <nav class="nav-links" id="nav-links">
      <a href="#about">About</a>
      <a href="#experience">Experience</a>
      <a href="#projects">Projects</a>
      <a href="#publications">Publications</a>
      <a href="#awards">Awards</a>
      <a href="#activities">Activities</a>
      <a href="#patents">Patents</a>
      <button class="theme-toggle" id="theme-toggle" aria-label="Toggle dark mode" title="Toggle dark mode">
        <svg class="icon sun"><use href="#i-sun"/></svg><svg class="icon moon"><use href="#i-moon"/></svg>
      </button>
    </nav>
  </div>
</header>

<main>
  <!-- ======================= ABOUT ======================= -->
  <section id="about" class="section about">
    <div class="container about-grid">
      <aside class="profile-card">
        <img class="avatar" src="{{ profile.avatar }}" alt="{{ profile.name }}" width="220" height="220">
        <h1 class="name">{{ profile.name }}</h1>
        <p class="name-native">{{ profile.name_native }}</p>
        <p class="role">{{ profile.role }}</p>
        <p class="org"><a href="{{ profile.org_url }}" target="_blank" rel="noopener">{{ profile.org }}</a></p>
        <p class="group">{{ profile.group }}</p>
        <ul class="social">
          {% if profile.email %}<li><a href="mailto:{{ profile.email }}" title="Email" aria-label="Email"><svg class="icon"><use href="#i-mail"/></svg></a></li>{% endif %}
          {% if L.scholar %}<li><a href="{{ L.scholar }}" target="_blank" rel="noopener" title="Google Scholar" aria-label="Google Scholar"><svg class="icon"><use href="#i-scholar"/></svg></a></li>{% endif %}
          {% if L.github %}<li><a href="{{ L.github }}" target="_blank" rel="noopener" title="GitHub" aria-label="GitHub"><svg class="icon"><use href="#i-github"/></svg></a></li>{% endif %}
          {% if L.linkedin %}<li><a href="{{ L.linkedin }}" target="_blank" rel="noopener" title="LinkedIn" aria-label="LinkedIn"><svg class="icon"><use href="#i-linkedin"/></svg></a></li>{% endif %}
          {% if L.orcid %}<li><a href="{{ L.orcid }}" target="_blank" rel="noopener" title="ORCID" aria-label="ORCID"><svg class="icon"><use href="#i-orcid"/></svg></a></li>{% endif %}
          {% if profile.cv %}<li><a href="{{ profile.cv }}" target="_blank" rel="noopener" title="CV" aria-label="CV"><svg class="icon"><use href="#i-cv"/></svg></a></li>{% endif %}
        </ul>
        {% if profile.email %}<p class="email"><a href="mailto:{{ profile.email }}">{{ profile.email }}</a></p>{% endif %}
      </aside>

      <div class="about-body">
        <h2 class="h2">Biography</h2>
        {% for para in profile.bio %}
        <p class="bio">{{ para | safe }}</p>
        {% endfor %}
        <div class="about-cols">
          <div>
            <h3 class="h3">Interests</h3>
            <ul class="interests">
              {% for it in profile.interests %}<li>{{ it }}</li>{% endfor %}
            </ul>
          </div>
          <div>
            <h3 class="h3">Education</h3>
            <ul class="edu">
              {% for e in profile.education %}
              <li>
                <svg class="icon"><use href="#i-grad"/></svg>
                <div>
                  <div class="edu-degree">{{ e.degree }}{% if e.year %}, {{ e.year }}{% endif %}</div>
                  <div class="edu-inst">{{ e.institution }}</div>
                  {% if e.note %}<div class="edu-note">{{ e.note }}</div>{% endif %}
                </div>
              </li>
              {% endfor %}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  {% if profile.news %}
  <!-- ======================= NEWS ======================= -->
  <section id="news" class="section section-alt">
    <div class="container">
      <h2 class="h2">News</h2>
      <ul class="news">
        {% for n in profile.news %}
        <li><span class="news-date">{{ n.date }}</span><span class="news-text">{{ n.text | safe }}</span></li>
        {% endfor %}
      </ul>
    </div>
  </section>
  {% endif %}

  <!-- ======================= EXPERIENCE ======================= -->
  <section id="experience" class="section">
    <div class="container">
      <h2 class="h2">Experience</h2>
      <ol class="timeline">
        {% for x in profile.experience %}
        <li class="tl-item">
          <div class="tl-dot"></div>
          <div class="tl-body">
            <div class="tl-head">
              <h3 class="tl-title">{{ x.title }}</h3>
              <span class="tl-dates">{{ x.start }} – {{ x.end }}</span>
            </div>
            <div class="tl-org">{{ x.org }}{% if x.location %} <span class="tl-loc"><svg class="icon"><use href="#i-pin"/></svg>{{ x.location }}</span>{% endif %}</div>
            {% if x.bullets %}
            <ul class="tl-bullets">{% for b in x.bullets %}<li>{{ b }}</li>{% endfor %}</ul>
            {% endif %}
          </div>
        </li>
        {% endfor %}
      </ol>
    </div>
  </section>

  {% if projects %}
  <!-- ======================= PROJECTS ======================= -->
  <section id="projects" class="section section-alt">
    <div class="container">
      <h2 class="h2">Industry Projects</h2>
      <p class="section-lead">Selected R&amp;D programmes I have led or contributed to at Samsung Electronics, from vision inspection foundation models to the MLOps and robotics that put them on production lines.</p>
      <div class="projects">
        {% for pj in projects %}
        <article class="project">
          <div class="project-head">
            <h3 class="project-title">{{ pj.title }}</h3>
            <span class="chip chip-period">{{ pj.period }}</span>
          </div>
          {% if pj.role %}<div class="project-role">{{ pj.role }}</div>{% endif %}
          <p class="project-summary">{{ pj.summary }}</p>
          {% if pj.bullets %}<ul class="project-bullets">{% for b in pj.bullets %}<li>{{ b }}</li>{% endfor %}</ul>{% endif %}
          {% if pj.tags %}<div class="tags">{% for t in pj.tags %}<span class="tag">{{ t }}</span>{% endfor %}</div>{% endif %}
        </article>
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  <!-- ======================= PUBLICATIONS ======================= -->
  <section id="publications" class="section">
    <div class="container">
      <div class="pub-header">
        <h2 class="h2">Publications</h2>
        <div class="pub-tools">
          <label class="search"><svg class="icon"><use href="#i-search"/></svg><input id="pub-search" type="search" placeholder="Search title, author, venue…" aria-label="Search publications"></label>
          <a class="btn btn-ghost" href="assets/publications.bib" download><svg class="icon"><use href="#i-bib"/></svg>BibTeX</a>
        </div>
      </div>
      <div class="filters" role="tablist" aria-label="Filter publications">
        <button class="filter is-active" data-filter="all">All <span class="count">{{ counts.all }}</span></button>
        <button class="filter" data-filter="selected">Selected <span class="count">{{ counts.selected }}</span></button>
        <button class="filter" data-filter="journal">Journal <span class="count">{{ counts.journal }}</span></button>
        <button class="filter" data-filter="conference">Conference <span class="count">{{ counts.conference }}</span></button>
        <button class="filter" data-filter="workshop">Workshop <span class="count">{{ counts.workshop }}</span></button>
        <button class="filter" data-filter="preprint">Preprint <span class="count">{{ counts.preprint }}</span></button>
      </div>
      <p class="pub-note"><strong>{{ self_name }}</strong> is shown in bold. Citation counts and the full list are on <a href="{{ L.scholar }}" target="_blank" rel="noopener">Google Scholar</a>.</p>

      <div id="pub-list">
      {% for yg in years %}
        <div class="year-group" data-year="{{ yg.year }}">
          <h3 class="year">{{ yg.year }}</h3>
          {% for p in yg.pubs %}
          {% set primary = p.links.paper or p.links.pdf or p.links.doi or p.links.arxiv or p.links.project or '' %}
          <article class="pub" data-type="{{ p.type }}" data-selected="{{ 1 if p.selected else 0 }}" data-search="{{ p.search }}">
            {% if primary %}<a class="pub-thumb" href="{{ primary }}" target="_blank" rel="noopener" tabindex="-1">{% else %}<div class="pub-thumb">{% endif %}
              <img src="{{ p.image }}" alt="" loading="lazy" width="240" height="180">
            {% if primary %}</a>{% else %}</div>{% endif %}
            <div class="pub-body">
              <h4 class="pub-title">{% if primary %}<a href="{{ primary }}" target="_blank" rel="noopener">{{ p.title }}</a>{% else %}{{ p.title }}{% endif %}</h4>
              <p class="pub-authors">
                {% for a in p.authors %}{% if a == self_name %}<strong>{{ a }}</strong>{% else %}{{ a }}{% endif %}{% if not loop.last %}, {% endif %}{% endfor %}
              </p>
              <p class="pub-venue">
                <span class="venue">{{ p.venue }}</span>{% if p.volume %}, vol. {{ p.volume }}{% endif %}{% if p.number %}, no. {{ p.number }}{% endif %}{% if p.pages %}, pp. {{ p.pages }}{% endif %}, {{ p.year }}.
                {% if p.note %}<span class="pub-extra">{{ p.note }}.</span>{% endif %}
              </p>
              <div class="pub-meta">
                <span class="type type-{{ p.type }}">{{ p.type_label }}</span>
                {% if p.award %}<span class="badge badge-award"><svg class="icon"><use href="#i-award"/></svg>{{ p.award }}</span>{% endif %}
                {% for t in p.tags %}<span class="badge">{{ t }}</span>{% endfor %}
              </div>
              <div class="pub-links">
                {% for k, label in link_order %}{% if p.links[k] %}<a class="btn" href="{{ p.links[k] }}" target="_blank" rel="noopener">{{ label }}</a>{% endif %}{% endfor %}
                <button class="btn btn-cite" data-bib="bib-{{ p.key }}" data-title="{{ p.title }}"><svg class="icon"><use href="#i-quote"/></svg>Cite</button>
              </div>
              <pre class="bib" id="bib-{{ p.key }}" hidden>{{ p.bibtex }}</pre>
            </div>
          </article>
          {% endfor %}
        </div>
      {% endfor %}
      </div>
      <p class="empty" id="pub-empty" hidden>No publications match your search.</p>

      {% if domestic %}
      <details class="domestic">
        <summary><span>Domestic conference papers (Korea)</span><span class="count">{{ domestic | length }}</span></summary>
        <ol class="domestic-list">
          {% for p in domestic %}
          <li>
            <span class="d-title">{{ p.title }}</span>
            <span class="d-authors">{% for a in p.authors %}{% if a == self_name %}<strong>{{ a }}</strong>{% else %}{{ a }}{% endif %}{% if not loop.last %}, {% endif %}{% endfor %}</span>
            <span class="d-venue">{{ p.venue }}{% if p.pages %}, pp. {{ p.pages }}{% endif %}, {{ p.year }}.{% if p.award %} <span class="badge badge-award"><svg class="icon"><use href="#i-award"/></svg>{{ p.award }}</span>{% endif %}</span>
          </li>
          {% endfor %}
        </ol>
      </details>
      {% endif %}
    </div>
  </section>

  {% if profile.awards %}
  <!-- ======================= AWARDS ======================= -->
  <section id="awards" class="section section-alt">
    <div class="container">
      <h2 class="h2">Awards &amp; Honors</h2>
      <ul class="awards">
        {% for a in profile.awards %}
        <li class="award">
          <span class="award-year">{{ a.year }}</span>
          <div class="award-body">
            <div class="award-title"><svg class="icon"><use href="#i-award"/></svg>{{ a.title }}</div>
            <div class="award-by">{{ a.by }}{% if a.note %} — <span class="award-note">{{ a.note }}</span>{% endif %}</div>
          </div>
        </li>
        {% endfor %}
      </ul>
    </div>
  </section>
  {% endif %}

  {% set act = profile.activities %}
  {% if act %}
  <!-- ======================= ACTIVITIES ======================= -->
  <section id="activities" class="section">
    <div class="container">
      <h2 class="h2">Activities</h2>
      <div class="activities">
        {% if act.talks %}
        <div class="act-block">
          <h3 class="h3">Invited Talks</h3>
          <ul class="talks">
            {% for t in act.talks %}<li><div class="talk-title">{{ t.title }}</div><div class="talk-where">{{ t.where }} · {{ t.date }}</div></li>{% endfor %}
          </ul>
        </div>
        {% endif %}
        {% if act.organizing %}
        <div class="act-block">
          <h3 class="h3">Organizing</h3>
          <ul class="plain">{% for o in act.organizing %}<li>{{ o }}</li>{% endfor %}</ul>
        </div>
        {% endif %}
        {% if act.reviewing %}
        <div class="act-block">
          <h3 class="h3">Reviewer</h3>
          <ul class="plain">{% for r in act.reviewing %}<li>{{ r }}</li>{% endfor %}</ul>
        </div>
        {% endif %}
        {% if act.teaching %}
        <div class="act-block">
          <h3 class="h3">Teaching</h3>
          <ul class="plain">{% for r in act.teaching %}<li>{{ r }}</li>{% endfor %}</ul>
        </div>
        {% endif %}
      </div>
    </div>
  </section>
  {% endif %}

  {% if profile.patents %}
  <!-- ======================= PATENTS ======================= -->
  <section id="patents" class="section section-alt">
    <div class="container">
      <h2 class="h2">Patents</h2>
      <ol class="patents">
        {% for pt in profile.patents %}
        <li><span class="pt-title">{{ pt.title }}</span><span class="pt-meta">{{ pt.inventors }} · {{ pt.number }}</span></li>
        {% endfor %}
      </ol>
    </div>
  </section>
  {% endif %}
</main>

<footer class="footer">
  <div class="container footer-inner">
    <span>© {{ year_now }} {{ profile.name }}. Last updated {{ updated }}.</span>
    <span class="footer-links">
      {% if profile.email %}<a href="mailto:{{ profile.email }}">Email</a>{% endif %}
      {% if L.scholar %}<a href="{{ L.scholar }}" target="_blank" rel="noopener">Scholar</a>{% endif %}
      {% if L.github %}<a href="{{ L.github }}" target="_blank" rel="noopener">GitHub</a>{% endif %}
      {% if L.linkedin %}<a href="{{ L.linkedin }}" target="_blank" rel="noopener">LinkedIn</a>{% endif %}
    </span>
  </div>
</footer>

<dialog id="cite-dialog" class="cite-dialog" aria-labelledby="cite-title">
  <div class="cite-head">
    <h3 id="cite-title">Cite</h3>
    <button class="icon-btn" id="cite-close" aria-label="Close"><svg class="icon"><use href="#i-x"/></svg></button>
  </div>
  <p class="cite-paper" id="cite-paper"></p>
  <pre id="cite-text" class="cite-text"></pre>
  <div class="cite-actions">
    <button class="btn btn-primary" id="cite-copy"><svg class="icon"><use href="#i-copy"/></svg><span>Copy BibTeX</span></button>
  </div>
</dialog>

<script src="assets/js/main.js"></script>
</body>
</html>
